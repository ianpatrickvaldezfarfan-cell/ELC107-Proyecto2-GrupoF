        <mxCell id="c4" value="Cliente de alice&lt;br&gt;(CLI / GUI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360.0" y="30" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Keystore local&lt;br&gt;~/.grupof/alice" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660.0" y="30" width="200" height="56" as="geometry" />
