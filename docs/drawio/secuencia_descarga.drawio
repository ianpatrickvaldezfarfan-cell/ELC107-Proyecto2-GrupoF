          <mxGeometry x="330.1" y="442" width="379.79999999999995" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="1. Verificar σ con RSA-PSS (clave pública de alice)&lt;br&gt;2. Validar AAD (dueño, file_id, tamaño)&lt;br&gt;3. K_s = RSA-OAEP-Dec(priv_bob, W_bob)&lt;br&gt;4. AES-256-GCM: verificar T y descifrar&lt;br&gt;5. Separar nombre real y datos; borrar K_s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
