        <mxCell id="c9" value="{C, nonce, T, AAD, σ, huella del firmante, W_bob}&lt;br&gt;(solo la clave envuelta de bob)" style="html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1">
